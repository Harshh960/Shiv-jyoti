# Fill in these values locally. Do not commit your filled .env to GitHub.
# Put the same values in Vercel > Project > Settings > Environment Variables.
APP_URL=http://localhost:3000

# Supabase > Project Settings > API / API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only Supabase secret key (sb_secret_...) or legacy service_role key.
SUPABASE_SECRET_KEY=

# Create this user in Supabase Authentication and confirm their email.
# There is no demo admin or default password.
ADMIN_EMAIL=

# Cloudflare R2 S3 API endpoint (or another S3-compatible endpoint).
# R2: https://ACCOUNT_ID.r2.cloudflarestorage.com
# AWS S3: leave endpoint blank; set the real AWS region below.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for R2 and most S3-compatible services; false is typical for AWS S3.
S3_FORCE_PATH_STYLE=true
